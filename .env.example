# Development branch — used for local dev and migrations (prisma migrate dev)
# Get this from your Neon dashboard → development branch → connection string (pooler)
DATABASE_URL=""

# Production branch — used only in production deployments (prisma migrate deploy)
# Get this from your Neon dashboard → production branch → connection string
DATABASE_URL_PRODUCTION=""

# Auth.js
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional for local production-style testing
AUTH_URL="http://localhost:3000/api/auth"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 (file/image uploads)
# Account ID is in the R2 dashboard URL: dash.cloudflare.com/<account-id>/r2
R2_ACCOUNT_ID=""
# Create an API token in R2 → Manage API Tokens with Object Read & Write permissions
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
